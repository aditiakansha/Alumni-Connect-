// Alumni Engagement Portal — Master Schema
// DB: MySQL | ORM: Prisma
// Owner: Aditya (auth/authorization module + master schema + integration)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  ALUMNI
  STUDENT
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum EventType {
  HACKATHON
  WORKSHOP
  MEETUP
  WEBINAR
}

enum RSVPStatus {
  GOING
  INTERESTED
  NOT_GOING
}

// ---------------------------------------------------------------------------
// AUTH / CORE USER
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile        Profile?
  postedJobs     Job[]          @relation("JobPoster")
  referralsMade  Referral[]     @relation("Requester")
  referralsGiven Referral[]     @relation("AlumniReferrer")
  referralRequests ReferralRequest[]
  jobApplications JobApplication[]
  forumPosts     ForumPost[]
  forumComments  ForumComment[]
  createdEvents  Event[]        @relation("EventCreator")
  eventRsvps     EventRSVP[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// REFRESH TOKENS
// ---------------------------------------------------------------------------

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// ALUMNI DIRECTORY
// ---------------------------------------------------------------------------

model Profile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String   @map("full_name")
  graduationYear  Int?     @map("graduation_year")
  degree          String?
  branch          String?
  currentCompany  String?  @map("current_company")
  currentPosition String?  @map("current_position")
  location        String?
  bio             String?  @db.Text
  linkedinUrl     String?  @map("linkedin_url")
  avatarUrl       String?  @map("avatar_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([graduationYear])
  @@index([branch])
  @@map("profiles")
}

// ---------------------------------------------------------------------------
// JOB / INTERNSHIP BOARD
// ---------------------------------------------------------------------------

model Job {
  id          String    @id @default(uuid())
  postedById  String    @map("posted_by_id")
  postedBy    User      @relation("JobPoster", fields: [postedById], references: [id], onDelete: Cascade)
  title       String
  company     String
  description String    @db.Text
  type        JobType
  location    String?
  applyUrl    String?   @map("apply_url")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  referrals Referral[]

  @@index([type])
  @@index([isActive])
  @@map("jobs")
}

model JobApplication {
  id          String   @id @default(uuid())
  requesterId String   @map("requester_id")
  requester   User     @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  jobKey      String   @map("job_key")
  jobTitle    String   @map("job_title")
  company     String
  resumeName  String   @map("resume_name")
  resumeData  String   @db.LongText @map("resume_data")
  appliedAt   DateTime @default(now()) @map("applied_at")

  @@unique([requesterId, jobKey])
  @@index([requesterId])
  @@map("job_applications")
}

// ---------------------------------------------------------------------------
// REFERRAL REQUEST SYSTEM
// ---------------------------------------------------------------------------

model Referral {
  id          String         @id @default(uuid())
  jobId       String         @map("job_id")
  job         Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requesterId String         @map("requester_id")
  requester   User           @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  alumniId    String         @map("alumni_id")
  alumni      User           @relation("AlumniReferrer", fields: [alumniId], references: [id], onDelete: Cascade)
  message     String?        @db.Text
  status      ReferralStatus @default(PENDING)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([jobId, requesterId, alumniId])
  @@index([status])
  @@map("referrals")
}

model ReferralRequest {
  id                 String         @id @default(uuid())
  requesterId        String         @map("requester_id")
  requester          User           @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  contactKey         String         @map("contact_key")
  contactName        String         @map("contact_name")
  contactRole        String?        @map("contact_role")
  contactCompany     String?        @map("contact_company")
  contactLinkedinUrl String?        @map("contact_linkedin_url")
  targetRole         String         @map("target_role")
  targetCompany      String?        @map("target_company")
  message            String?        @db.Text
  status             ReferralStatus @default(PENDING)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@index([requesterId])
  @@index([contactKey])
  @@map("referral_requests")
}

// ---------------------------------------------------------------------------
// DISCUSSION FORUM
// ---------------------------------------------------------------------------

model ForumPost {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  category  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  comments ForumComment[]

  @@index([category])
  @@map("forum_posts")
}

model ForumComment {
  id        String    @id @default(uuid())
  postId    String    @map("post_id")
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String    @map("author_id")
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([postId])
  @@map("forum_comments")
}

// ---------------------------------------------------------------------------
// EVENTS BOARD
// ---------------------------------------------------------------------------

model Event {
  id              String    @id @default(uuid())
  createdById     String    @map("created_by_id")
  createdBy       User      @relation("EventCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title           String
  description     String    @db.Text
  type            EventType
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  location        String?
  isOnline        Boolean   @default(false) @map("is_online")
  registrationUrl String?   @map("registration_url")
  createdAt       DateTime  @default(now()) @map("created_at")

  rsvps EventRSVP[]

  @@index([startDate])
  @@index([type])
  @@map("events")
}

// ---------------------------------------------------------------------------
// EVENT RSVPs
// ---------------------------------------------------------------------------

model EventRSVP {
  id        String     @id @default(uuid())
  eventId   String     @map("event_id")
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    RSVPStatus @default(GOING)
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([eventId, userId])
  @@map("event_rsvps")
}
